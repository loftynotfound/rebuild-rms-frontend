{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "bracketSameLine": true,
  "plugins": ["prettier-plugin-tailwindcss"],

  "overrides": [
    {
      "files": "*.js",
      "options": {
        "singleQuote": false,
        "semi": true
      }
    },
    {
      "files": "*.vue",
      "options": {
        "singleQuote": false,
        "semi": true,
        "vueIndentScriptAndStyle": false
      }
    }
  ]
}
